# URL base del backend NestJS, disponible únicamente en el servidor.
BACKEND_API_URL=

# Tiempo máximo de cada solicitud HTTP, expresado en milisegundos.
BACKEND_API_TIMEOUT_MS=30000

# Origen público de Next para redirects server-side de OAuth.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL pública de la landing que expone el catálogo mayorista.
NEXT_PUBLIC_CATALOG_API_URL=https://saeltendencia.store
